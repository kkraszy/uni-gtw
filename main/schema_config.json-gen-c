// uni-gtw — config schema
// Defines enums shared across WS and MQTT schemas, the channel struct,
// and the top-level gateway_config_t persisted to LittleFS.

// ── Enums ─────────────────────────────────────────────────────────────────────

// Matches channel_state_name() strings in channel.c
enum channel_state_t {
    unknown,
    closing,
    closed,
    opening,
    open,
    comfort,
    partially_open,
    obstruction,
    in_motion
}

// cmd_name values accepted by the channel_cmd WebSocket message
enum channel_cmd_name_t {
    UP,
    DOWN,
    STOP,
    UP_DOWN,
    STOP_DOWN,
    STOP_HOLD,
    PROG,
    STOP_UP,
    REQUEST_FEEDBACK,
    REQUEST_POSITION,
    SET_POSITION,
    SET_TILT,
    TILT_INCREASE,
    TILT_DECREASE
}

enum language_t {
    en,
    pl
}

enum wifi_mode_t {
    ap,
    sta
}

enum radio_status_t {
    ok,
    error,
    not_configured
}

enum mqtt_status_t {
    connected,
    connecting,
    disconnected,
    unconfigured
}

// Matches cosmo_channel_device_class_t in channel.h.
// Values serialise as strings (e.g. "shutter", "blind").
// json-gen-c unmarshal also accepts the legacy integer form.
enum channel_device_class_t {
    generic,
    awning,
    blind,
    curtain,
    damper,
    door,
    garage,
    gate,
    shade,
    shutter,
    window,
    light,
    switch,
    hidden
}

// Response struct for GET /api/info (unauthenticated)
struct web_info_t {
    bool web_password_enabled;
    sstr_t language;
    nullable bool web_password_valid;  // present only when X-Auth header was supplied
    sstr_t hostname;
    sstr_t chip;
    sstr_t app_version;
    sstr_t app_project_name;
    sstr_t app_build_time;
    sstr_t app_build_date;
    sstr_t app_idf_ver;
    sstr_t app_elf_sha256;
}

// ── Config sub-structs ────────────────────────────────────────────────────────

struct mqtt_config_t {
    bool enabled;
    sstr_t url;
    sstr_t username;
    sstr_t password;
    bool ha_discovery_enabled;
    sstr_t ha_prefix;
    sstr_t mqtt_prefix;
}

enum radio_type_t {
    cc1101,
    sx1262
}

enum hardware_preset_t {
    custom,
    alufers_esp_cc1101_board,
    heltec_v4,
    xiao_esp32s3_wio_sx1262
}

struct hardware_config_t {
    bool enabled;
    radio_type_t type;
    int gpio_miso;
    int gpio_mosi;
    int gpio_sck;
    int gpio_csn;
    int gpio_gdo0;        // CC1101: GDO0 IRQ; SX1262: DIO1 IRQ
    int gpio_rst;         // SX1262 RST (-1 for CC1101)
    int gpio_busy;        // SX1262 BUSY (-1 for CC1101)
    int gpio_pa_enable;   // External PA enable output (-1 to disable)
    int spi_freq_hz;
    int gpio_status_led;
}

struct hardware_preset_info_t {
    sstr_t id;
    sstr_t name;
    sstr_t description;
    hardware_config_t hardware;
}

struct hardware_presets_list_t {
    hardware_preset_info_t presets[];
}

enum channel_state_type_t {
    reported,
    optimistic,
    timed_out
}

// cosmo_channel_t — serialised by channel_to_cjson()
// proto is kept as sstr_t ("1way"/"2way" cannot be C identifiers)
struct cosmo_channel_t {
    // ── Config ───────────────────────────────────────────────────────────────
    uint32_t serial;
    sstr_t name;
    sstr_t proto;
    bool reports_tilt_support;
    bool force_tilt_support;
    bool bidirectional_feedback;
    uint16_t feedback_timeout_s;
    channel_device_class_t device_class;
    sstr_t mqtt_name;
    uint32_t external_remotes[];  // serials of physical remotes paired to the same motor

    // ── State ────────────────────────────────────────────────────────────────
    uint16_t counter;
    channel_state_t state;
    channel_state_type_t state_type;
    int8_t rssi;
    nullable int16_t position;  // 0–100 % open; null when 1-way or position unknown

    // ── Timestamps ───────────────────────────────────────────────────────────
    int64_t last_seen_ts;
    int64_t last_command_ts;
    int64_t last_position_query_ts;
}

// Top-level persisted config (gateway_config_t in C)
struct gateway_config_t {
    int version;
    sstr_t hostname;
    mqtt_config_t mqtt;
    hardware_config_t hardware;
    hardware_preset_t hardware_preset;
    int position_status_query_interval_s;
    bool web_password_enabled;
    sstr_t web_password;   // PBKDF2 hash: base64(16-byte salt) + "$" + base64(32-byte output)
    language_t language;
    bool prometheus_enable;
    cosmo_channel_t channels[];
}
